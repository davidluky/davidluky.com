      pp_h_not_collect: 'What we do not collect',
      pp_nc1: 'Location data',
      pp_nc2: 'Your device address book or phone number',
      pp_nc3: 'Access to photos stored on your device, camera, or microphone',
      pp_nc4: 'Advertising IDs or device identifiers used for advertising or tracking',
      pp_nc5: 'Third-party analytics, advertising tracking, or crash-reporting SDKs',
